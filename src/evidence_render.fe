#![cfg(target = "native")]

use core::text::hex
use std::io::Stdout

use super::digest_check::DigestCheck

/// Print the opening of the Fe evidence JSON document, before the results array.
pub fn json_header(_ complete_catalogue: bool) uses (out: mut Stdout) {
    println!("{")
    println!("  \"backend\": \"native\",")
    println!("  \"engine\": \"fe\",")
    println!("  \"fe_version\": \"26.6.0\",")
    println!("  \"project\": \"Hashmark\",")
    println!("  \"protocol\": \"HASHMARK/FE-EVIDENCE/1\",")
    if complete_catalogue {
        println!("  \"complete_catalogue\": true,")
    } else {
        println!("  \"complete_catalogue\": false,")
    }
    println!("  \"results\": [")
}

/// Print one vector result object inside the Fe evidence JSON results array.
pub fn json_vector<const I: usize, const A: usize, const C: usize>(
    _ vector_id: String<I>,
    _ algorithm: String<A>,
    _ category: String<C>,
    _ input_length: usize,
    _ input_sha256: u256,
    _ check: DigestCheck,
    _ last: bool,
) -> bool
uses (out: mut Stdout)
{
    let passed = check.passes()
    println!("    {")
    println!("      \"algorithm\": \"", algorithm, "\",")
    println!("      \"category\": \"", category, "\",")
    println!(
        "      \"expected_digest\": \"",
        hex(check.expected(), 32),
        "\",",
    )
    println!(
        "      \"fe_digest\": \"",
        hex(check.observed(), 32),
        "\",",
    )
    println!("      \"input_length_bytes\": ", input_length, ",")
    println!("      \"input_sha256\": \"", hex(input_sha256, 32), "\",")
    println!(
        "      \"status\": \"",
        if passed { "PASS" } else { "FAIL" },
        "\",",
    )
    println!("      \"vector_id\": \"", vector_id, "\"")
    if last {
        println!("    }")
    } else {
        println!("    },")
    }
    passed
}

/// Print the transition from the results array to the streaming checks array.
pub fn json_streaming_open() uses (out: mut Stdout) {
    println!("  ],")
    println!("  \"streaming_checks\": [")
}

/// Print the canonical name line for one streaming check inside the JSON document.
fn json_streaming_name(_ index: usize) uses (out: mut Stdout) {
    if index == 0 {
        println!("      \"name\": \"sha256_streaming_matches_one_shot\",")
    } else if index == 1 {
        println!(
            "      \"name\": \"keccak256_streaming_matches_one_shot\",",
        )
    } else if index == 2 {
        println!(
            "      \"name\": \"sha256_uneven_partition_matches_one_shot\",",
        )
    } else if index == 3 {
        println!(
            "      \"name\": \"keccak256_uneven_partition_matches_one_shot\",",
        )
    } else if index == 4 {
        println!(
            "      \"name\": \"sha256_two_part_splits_match_one_shot\",",
        )
    } else {
        println!(
            "      \"name\": \"keccak256_two_part_splits_match_one_shot\",",
        )
    }
}

/// Print one streaming check object inside the Fe evidence JSON document.
pub fn json_streaming_check(_ index: usize, _ passed: bool, _ last: bool)
uses (out: mut Stdout)
{
    println!("    {")
    json_streaming_name(index)
    println!(
        "      \"status\": \"",
        if passed { "PASS" } else { "FAIL" },
        "\"",
    )
    if last {
        println!("    }")
    } else {
        println!("    },")
    }
}

/// Print the summary object and close the Fe evidence JSON document.
pub fn json_summary(_ total: usize, _ passed: usize, _ streaming_passed: usize)
uses (out: mut Stdout)
{
    let failed = total - passed
    let all_passed = failed == 0 && streaming_passed == 6
    println!("  ],")
    println!("  \"summary\": {")
    println!("    \"failed\": ", failed, ",")
    println!("    \"passed\": ", passed, ",")
    if all_passed {
        println!("    \"status\": \"PASS\",")
    } else {
        println!("    \"status\": \"FAIL\",")
    }
    println!("    \"streaming_passed\": ", streaming_passed, ",")
    println!("    \"streaming_total\": 6,")
    println!("    \"total\": ", total)
    println!("  },")
    println!("  \"target\": \"native\"")
    println!("}")
}

/// Print the heading of the Fe evidence Markdown report.
pub fn markdown_header(_ complete_catalogue: bool) uses (out: mut Stdout) {
    println!("# Hashmark Fe evidence — native")
    println!("")
    println!(
        "Generated by the Hashmark Fe engine (Fe 26.6.0, HASHMARK/FE-EVIDENCE/1).",
    )
    if complete_catalogue {
        println!("Scope: complete vector catalogue.")
    } else {
        println!("Scope: selected vectors only.")
    }
    println!("")
    println!(
        "| Vector | Algorithm | Category | Bytes | Expected | Fe observed | Status |",
    )
    println!("| --- | --- | --- | ---: | --- | --- | --- |")
}

/// Print one vector row inside the Fe evidence Markdown report.
pub fn markdown_vector<const I: usize, const A: usize, const C: usize>(
    _ vector_id: String<I>,
    _ algorithm: String<A>,
    _ category: String<C>,
    _ input_length: usize,
    _ check: DigestCheck,
) -> bool
uses (out: mut Stdout)
{
    let passed = check.passes()
    println!(
        "| ",
        vector_id,
        " | ",
        algorithm,
        " | ",
        category,
        " | ",
        input_length,
        " | ",
        hex(check.expected(), 32),
        " | ",
        hex(check.observed(), 32),
        " | ",
        if passed { "PASS" } else { "FAIL" },
        " |",
    )
    passed
}

/// Print the streaming checks heading of the Fe evidence Markdown report.
pub fn markdown_streaming_open() uses (out: mut Stdout) {
    println!("")
    println!("## Streaming checks")
    println!("")
}

/// Print one streaming check line inside the Fe evidence Markdown report.
pub fn markdown_streaming_check(_ index: usize, _ passed: bool)
uses (out: mut Stdout)
{
    if index == 0 {
        println!(
            "- sha256_streaming_matches_one_shot: ",
            if passed { "PASS" } else { "FAIL" },
        )
    } else if index == 1 {
        println!(
            "- keccak256_streaming_matches_one_shot: ",
            if passed { "PASS" } else { "FAIL" },
        )
    } else if index == 2 {
        println!(
            "- sha256_uneven_partition_matches_one_shot: ",
            if passed { "PASS" } else { "FAIL" },
        )
    } else if index == 3 {
        println!(
            "- keccak256_uneven_partition_matches_one_shot: ",
            if passed { "PASS" } else { "FAIL" },
        )
    } else if index == 4 {
        println!(
            "- sha256_two_part_splits_match_one_shot: ",
            if passed { "PASS" } else { "FAIL" },
        )
    } else {
        println!(
            "- keccak256_two_part_splits_match_one_shot: ",
            if passed { "PASS" } else { "FAIL" },
        )
    }
}

/// Print the closing summary of the Fe evidence Markdown report.
pub fn markdown_summary(_ total: usize, _ passed: usize, _ streaming_passed: usize)
uses (out: mut Stdout)
{
    let failed = total - passed
    let all_passed = failed == 0 && streaming_passed == 6
    println!("")
    println!("## Summary")
    println!("")
    println!(
        "Vectors: ",
        passed,
        " passed, ",
        failed,
        " failed, ",
        total,
        " total.",
    )
    println!("Streaming checks: ", streaming_passed, " of 6 passed.")
    if all_passed {
        println!("Status: PASS")
    } else {
        println!("Status: FAIL")
    }
}
