#![cfg(target = "native")]

use core::text::hex
use std::env::Args
use std::io::{Stderr, Stdout}

use super::digest_check::DigestCheck
use super::{conformance, deterministic_input, engine, generated_vectors, keccak256, sha256}

fn emit<const I: usize, const A: usize>(
    _ vector_id: String<I>,
    _ algorithm: String<A>,
    _ input_length: usize,
    _ check: DigestCheck,
) -> bool
uses (out: mut Stdout)
{
    let passed = check.passes()
    println!(
        "HASHMARK/1\t",
        vector_id,
        "\t",
        algorithm,
        "\t",
        input_length,
        "\t",
        hex(check.observed(), 32),
        "\tnative\t",
        if passed { "pass" } else { "fail" },
    )
    passed
}

pub fn run() -> i32 uses (args: Args, out: mut Stdout, err: mut Stderr) {
    let argument_count = args.count()
    let select_all = argument_count == 1 || (argument_count == 2 && args.get(1) == "--all")
    let select_algorithm = argument_count == 3 && args.get(1) == "--algorithm"
    let select_vector = argument_count == 3 && args.get(1) == "--vector"
    let select_self_test = argument_count == 2 && args.get(1) == "--self-test"
    let select_evidence_json = (argument_count == 2 || argument_count == 4)
        && args.get(1) == "--evidence-json"
        && (argument_count == 2 || args.get(2) == "--algorithm" || args.get(2) == "--vector")
    let select_evidence_markdown = (argument_count == 2 || argument_count == 4)
        && args.get(1) == "--evidence-markdown"
        && (argument_count == 2 || args.get(2) == "--algorithm" || args.get(2) == "--vector")
    let evidence_mode = select_evidence_json || select_evidence_markdown
    let ev_select_algorithm = evidence_mode && argument_count == 4 && args.get(2) == "--algorithm"
    let ev_select_vector = evidence_mode && argument_count == 4 && args.get(2) == "--vector"
    if !(select_all || select_algorithm || select_vector || select_self_test || evidence_mode) {
        eprintln!(
            "usage: hashmark [--all | --algorithm sha256|keccak256 | --vector id | --self-test | --evidence-json [--algorithm a | --vector id] | --evidence-markdown [--algorithm a | --vector id]]",
        )
        return 2
    }
    if select_self_test {
        let passed = conformance::streaming_suite()
        println!(
            "HASHMARK/SELFTEST/1\t",
            if passed { "pass" } else { "fail" },
