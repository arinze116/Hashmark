use core::hash::{HashInput, Keccak256, keccak256, keccak256_word}

/// Hash borrowed bytes with Fe's Ethereum Keccak-256 implementation.
pub fn digest<T: HashInput>(_ input: T) -> [u8; 32] {
    keccak256(input)
}

/// Hash borrowed bytes and return the digest as a big-endian word.
pub fn digest_word<T: HashInput>(_ input: T) -> u256 {
    keccak256_word(input)
}

/// Hash the input through repeated updates of at most `chunk_size` bytes.
pub fn stream_word<T: HashInput>(_ input: T, _ chunk_size: usize) -> u256 {
    assert!(chunk_size > 0, "Keccak-256 chunk size must be positive")
    var state = Keccak256::new()
    var offset: usize = 0
    let input_len = input.input_len()
    while offset < input_len {
        let remaining = input_len - offset
        let chunk_len = if chunk_size < remaining {
            chunk_size
        } else {
            remaining
        }
        state.update(input, offset, len: chunk_len)
        offset += chunk_len
    }
    state.finish_word()
}

/// Exercise the documented no-op update before hashing the complete input.
pub fn stream_with_empty_update_word<T: HashInput>(_ input: T) -> u256 {
    var state = Keccak256::new()
    state.update(input, offset: 0, len: 0)
    state.update(input, offset: 0, len: input.input_len())
    state.finish_word()
}
