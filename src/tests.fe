use ingot::{conformance, deterministic_input, generated_vectors, keccak256, sha256}

#[test]
fn sha256_known_answers() {
    assert!(
        sha256::check([0 as u8; 0], generated_vectors::SHA256_EMPTY).passes(),
    )
    assert!(
        sha256::check([97 as u8, 98, 99], generated_vectors::SHA256_ABC).passes(),
    )
    assert!(
        sha256::check([0xd3 as u8], generated_vectors::SHA256_NIST_SHORT_D3).passes(),
    )
}

#[test]
fn keccak256_known_answers() {
    assert!(
        keccak256::check([0 as u8; 0], generated_vectors::KECCAK256_EMPTY).passes(),
    )
    assert!(
        keccak256::check([97 as u8, 98, 99], generated_vectors::KECCAK256_ABC).passes(),
    )
}

#[test]
fn sha256_generated_vectors() {
    for index in 0 .. generated_vectors::SHA256_GENERATED_LENGTHS.len() {
        let input = deterministic_input(generated_vectors::SHA256_GENERATED_LENGTHS[index])
        assert!(
            sha256::check(
                input.span(),
                generated_vectors::SHA256_GENERATED_DIGESTS[index],
            )
                .passes(),
        )
    }
}

#[test]
fn keccak256_generated_vectors() {
    for index in 0 .. generated_vectors::KECCAK256_GENERATED_LENGTHS.len() {
        let input = deterministic_input(generated_vectors::KECCAK256_GENERATED_LENGTHS[index])
        assert!(
            keccak256::check(
                input.span(),
                generated_vectors::KECCAK256_GENERATED_DIGESTS[index],
            )
                .passes(),
        )
    }
}

